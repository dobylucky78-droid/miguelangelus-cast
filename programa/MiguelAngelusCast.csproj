<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MiguelAngelus Cast: transmissão de celebrações. Código aberto (MIT).
    v0 = transmissão (cenas, transições, saída, som, roteiro). Rastreio da PTZ (pasta Rastreio\): a lógica do kit em ..\kit-rastreio.
    .NET 8, publicado "self-contained": não precisa instalar o .NET no computador da igreja.
    Gerar:  dotnet publish -c Release -o "<pasta>"
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MiguelAngelusCast</AssemblyName>
    <RootNamespace>MiguelAngelusCast</RootNamespace>
    <ApplicationIcon>icone.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.1.10</Version>
    <Product>MiguelAngelus Cast</Product>
    <Description>MiguelAngelus Cast — transmissão de celebrações</Description>
    <Copyright>Copyright (c) 2026 Marcio Aurelio Rios Martins — licença MIT</Copyright>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- o pacote do WebView2 traz também a parte de WPF, que não usamos -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio.Asio" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- rastreio: detector YuNet (MIT) e reconhecimento SFace (Apache 2.0) com ONNX Runtime (MIT) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="web\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="modelos\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- (0.1.6) plugin para o Stream Dock / Stream Deck; o Cast instala pelos Ajustes -->
    <Content Include="streamdock\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- FFmpeg LGPL (build "lgpl-shared" do BtbN), processo separado, com a sua LICENSE. Não vai para o repositório. -->
    <Content Include="ffmpeg\**\*" CopyToOutputDirectory="PreserveNewest" Condition="Exists('ffmpeg\ffmpeg.exe')" />
  </ItemGroup>
</Project>
