<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MiguelAngelus Cast — transmissão de celebrações (código aberto; licença a definir, sugestão GPL).
    0.1 = kit de testes: câmera PTZ por NDI, rastreio de rosto movendo a câmera por VISCA, e telemetria em arquivo.
    Gerar:  dotnet publish -c Release -o "<pasta do kit>"
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MiguelAngelusCast</AssemblyName>
    <RootNamespace>MiguelAngelusCast</RootNamespace>
    <ApplicationIcon>icone.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>MiguelAngelus Cast</Product>
    <Description>MiguelAngelus Cast — kit de testes (rastreio PTZ + telemetria)</Description>
    <Copyright>Paróquia São José Operário — PASCOM</Copyright>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <Reference Include="System.Management" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="modelos\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="LEIAME.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
